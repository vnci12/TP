<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panier</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- appel de la navbar -->
    <%- include('navbar') %>

    <h1>Votre Panier</h1>
        <div class="container-panier">
            <div class="panier-container">
                <% if (resultatPanier.length > 0) { %>
                    <% resultatPanier.forEach(resultat => { %>
                        <div class="card-panier">
                            <% if (resultat.nom) { %>
                                <p><strong>Offre :</strong> <%= resultat.nom %></p>
                                <p><strong>Data incluse :</strong> <%= resultat.data_incluse %> Go</p>
                                <p><strong>Appels/SMS inclus :</strong> <%= resultat.appels_sms_inclus %></p>
                            <% } %>
                            <% if (resultat.marque) { %>
                                <p><strong>Marque :</strong> <%= resultat.marque %></p>
                            <% } %>
                            <% if (resultat.modele) { %>
                                <p><strong>Modèle :</strong> <%= resultat.modele %></p>
                            <% } %>
                            <p><strong>Prix :</strong> <%= resultat.prix %> €</p>
                            <input type="button" value="Supprimer" onclick="supprimerPanier('<%= resultat.id %>')">
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Votre panier est actuellement vide. Ajoutez des offres mobiles ou des téléphones pour les voir ici.</p>
                <% } %>
            </div>
        </div>
</body>
<script src="/JS/panier.js"></script>
</html>